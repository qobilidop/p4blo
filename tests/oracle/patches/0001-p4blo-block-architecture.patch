+           Inst.Hook.register [];
+           Inst.Hook.init_spec spec_sim;
+           Backend_sim.P4blo.Pipe.serve includes_p4 stdin stdout;
+           Inst.Hook.finish ();
+           Ok ()))
+
 let cover_run_command =
