diff --git a/p4spec/lib/backend-il/il_export.ml b/p4spec/lib/backend-il/il_export.ml
new file mode 100644
index 0000000..68281c7
--- /dev/null
+++ b/p4spec/lib/backend-il/il_export.ml
@@ -0,0 +1,94 @@
+(* Structural JSON for IL values.
+
+   p4blo (https://github.com/qobilidop/p4blo) translates a P4 program into
+   its own IR from the program the spec itself typed and instantiated, so
+   that elaboration is a function over the spec's output rather than a
+   second parser. This module writes those values as JSON that a reader can
+   walk without the spec's grammar: every variant value names its syntax
+   type and its constructor, and every field is kept.
+
+     BoolV b             true / false
+     NumV (Nat n)        n, as a JSON integer of any size
+     NumV (Int i)        {"int": i}
+     TextV s             {"text": s}
+     StructV fields      {"t": <type>, "s": [[<atom>, <value>], ...]}
+     CaseV (mixop, vs)   {"t": <type>, "c": <mixop>, "a": [<value>, ...]}
+     TupleV vs           {"tuple": [<value>, ...]}
+     OptV v              {"opt": <value> or null}
+     ListV vs            [<value>, ...]
+     FuncV id            {"func": id}
+     ExternV j           {"extern": j}
+
+   <type> is the name of the value's syntax type (`expressionIR`, `typeIR`,
+   ...) and <mixop> the constructor as the spec writes it, with `%` for each
+   argument (`BinE % % %` is written "BinE%%%"). Struct fields keep their
+   order. Nothing is normalized or dropped. *)
+
+open Lang
+module Mixfix = Domain.Mixfix
+
+let type_name (typ : Il.typ') : string =
+  match typ with
+  | Il.VarT (id, _) -> id.it
+  | Il.BoolT -> "bool"
+  | Il.NumT `NatT -> "nat"
+  | Il.NumT `IntT -> "int"
+  | Il.TextT -> "text"
+  | Il.TupleT _ -> "tuple"
+  | Il.IterT _ -> "iter"
+  | Il.FuncT _ -> "func"
+
+(* The mixop without the backquotes Mixfix.to_string adds. *)
+let mixop_name (valuecase : Il.valuecase) : string =
+  let s = Mixfix.to_string valuecase in
+  let n = String.length s in
+  if n >= 2 && s.[0] = '`' && s.[n - 1] = '`' then String.sub s 1 (n - 2)
+  else s
+
+let rec value_to_json (value : Il.value) : Yojson.Safe.t =
+  match value.it with
+  | Il.BoolV b -> `Bool b
+  | Il.NumV (`Nat n) -> `Intlit (Bigint.to_string n)
+  | Il.NumV (`Int i) -> `Assoc [ ("int", `Intlit (Bigint.to_string i)) ]
+  | Il.TextV s -> `Assoc [ ("text", `String s) ]
+  | Il.StructV fields ->
+      `Assoc
+        [
+          ("t", `String (type_name value.note.typ));
+          ( "s",
+            `List
+              (List.map
+                 (fun ((atom : Il.atom), v) ->
+                   `List
+                     [
+                       `String (Domain.Atom.string_of_atom atom.it);
+                       value_to_json v;
+                     ])
+                 fields) );
+        ]
+  | Il.CaseV valuecase ->
+      `Assoc
+        [
+          ("t", `String (type_name value.note.typ));
+          ("c", `String (mixop_name valuecase));
+          ("a", `List (List.map value_to_json (Mixfix.args valuecase)));
+        ]
+  | Il.TupleV values -> `Assoc [ ("tuple", `List (List.map value_to_json values)) ]
+  | Il.OptV None -> `Assoc [ ("opt", `Null) ]
+  | Il.OptV (Some v) -> `Assoc [ ("opt", value_to_json v) ]
+  | Il.ListV values -> `List (List.map value_to_json values)
+  | Il.FuncV id -> `Assoc [ ("func", `String id.it) ]
+  | Il.ExternV json -> `Assoc [ ("extern", json) ]
+
+(* The export: the typed program (the output of `Program_ok`) and the
+   instantiation (the outputs of `Program_inst`: the global layer and the
+   store of instantiated objects). *)
+let export ~(program : Il.value) ~(global : Il.value) ~(store : Il.value) :
+    Yojson.Safe.t =
+  `Assoc
+    [
+      ("format", `String "p4spectec-il-export/1");
+      ("program", value_to_json program);
+      ("global", value_to_json global);
+      ("store", value_to_json store);
+    ]
