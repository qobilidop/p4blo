diff --git a/p4spec/bin/main.ml b/p4spec/bin/main.ml
index 4be966e..f079b6b 100644
--- a/p4spec/bin/main.ml
+++ b/p4spec/bin/main.ml
@@ -678,6 +678,49 @@ let parse_command =
            | Sys_error msg -> file_error ("file error: " ^ msg)
            | e -> file_error ("unknown error: " ^ Printexc.to_string e)))
 
+(* Export a program's typed and instantiated IL as JSON (backend-il/), for
+   p4blo's frontend: the output of `Program_ok` and of `Program_inst`. *)
+let il_export_command =
+  Core.Command.basic
+    ~summary:"print a P4 program's typed and instantiated IL as JSON"
+    (let open Core.Command.Let_syntax in
+     let open Core.Command.Param in
+     let%map paths_spec = anon (non_empty_sequence_as_list ("path" %: string))
+     and includes_p4 = flag "-i" (listed string) ~doc:"P4 include paths"
+     and path_p4 = flag "-p" (required string) ~doc:"P4 program" in
+     fun () ->
+       run_with_diagnostics
+         ~action:(fun () ->
+           let* spec_sim = P4spectec.spec_of_mode SL_mode paths_spec in
+           let* simulator = P4spectec.build_sim spec_sim in
+           Ok (spec_sim, simulator))
+         ~on_success:(fun (spec_sim, simulator) ->
+           let (module Simulator : SIM) = simulator in
+           Inst.Hook.register [];
+           Inst.Hook.init_spec spec_sim;
+           let eval relname =
+             match Simulator.Interp.eval_program relname includes_p4 path_p4 with
+             | Pass values -> Ok values
+             | Fail (`Syntax diagnostic) -> Error diagnostic
+             | Fail (`Runtime failure) -> Error (diagnostic_of_failure failure)
+           in
+           let result =
+             let* typed = eval "Program_ok" in
+             let* inst = eval "Program_inst" in
+             match (typed, inst) with
+             | [ program ], [ global; store ] ->
+                 Backend_il.Il_export.export ~program ~global ~store
+                 |> Yojson.Safe.to_channel stdout;
+                 print_newline ();
+                 Ok ()
+             | _ ->
+                 Error
+                   (Diagnostic.error ~source:"p4" Util.Source.no_region
+                      "unexpected arity of Program_ok or Program_inst")
+           in
+           Inst.Hook.finish ();
+           result))
+
 let command =
   Core.Command.group
     ~summary:"p4spectec: a language design framework for the p4_16 language"
@@ -702,6 +745,7 @@ let command =
       ("splice", splice_command);
       (* Interfacing with P4 *)
       ("parse", parse_command);
+      ("il-export", il_export_command);
     ]
 
 let () = Command_unix.run ~version command
