;;
;; The p4blo block architecture
;;
;; Not an architecture in the usual sense: it runs one parser, control or
;; deparser of a program on the headers and metadata a caller supplies, and
;; hands back what the block left, with nothing in between. p4blo's IR has
;; no architecture (its blocks perform no effect beyond their parameters and
;; externs), so these relations are the whole of what a caller needs to
;; compare block semantics with block semantics. The package is declared in
;; p4blo's `tests/oracle/include/p4blo.p4`:
;;
;;   parser P4bloParser<H, M>(packet_in packet, out H hdr, inout M meta);
;;   control P4bloControl<H, M>(inout H hdr, inout M meta);
;;   control P4bloDeparser<H>(packet_out packet, in H hdr);
;;   package P4blo<H, M>(P4bloParser<H, M> p, P4bloControl<H, M> c,
;;                       P4bloDeparser<H> d);
;;
;; The global variables `hdr` and `meta` hold the block's arguments, as
;; V1Model's `hdr` and `meta` do; the driver writes and reads them around
;; each call. This file is passed to the spec explicitly by the `block`
;; command's caller and is not part of the spec directory, so nothing about
;; the existing architectures changes.
;;
;; This is p4blo's block contract: the definition, in the spec's own
;; language, of running one block, which p4blo's IR semantics is compared
;; with (and, eventually, related to by a theorem). It is written against
;; the P4-SpecTec commit tests/oracle/build.sh pins; the OCaml driver that
;; serves it is tests/oracle/patches/0001-p4blo-block-architecture.patch.
;;

relation P4blo_init:
  |- p4program : evalContext arch
  hint(input %0)

rule P4blo_init:
  |- p4program : EC ARCH
  -- Program_init:
      |- p4program : EC STO
  -- if ARCH = { STATE $init_archState, STORE STO }

;;
;; Packet objects and globals
;;

relation P4blo_init_packet_in:
  evalContext arch |- objectState : evalContext arch
  hint(input %0 %1 %2)

rule P4blo_init_packet_in:
  EC_0 ARCH_0 |- objectState_packet_in : EC_1 ARCH_2
  -- Extern_init: EC_0 ARCH_0 |- "packet_in" "packet_in" : ARCH_1
  -- if EC_1 = $add_var_e(GLOBAL, EC_0, _BARE "packet_in", REF "packet_in")
  -- if externObject_packet_in = $find_object_e(ARCH_1, [ "packet_in" ])
  -- if EXTERN typeId `< theta `> `{ _ frame externMethodDefEnv `}
      = externObject_packet_in
  -- if externObject_packet_in_init
      = EXTERN typeId `< theta `> `{ objectState_packet_in frame externMethodDefEnv `}
  -- if ARCH_2
      = $add_object_e(ARCH_1, [ "packet_in" ], externObject_packet_in_init)

relation P4blo_init_packet_out:
  evalContext arch |- objectState : evalContext arch
  hint(input %0 %1 %2)

rule P4blo_init_packet_out:
  EC_0 ARCH_0 |- objectState_packet_out : EC_1 ARCH_2
  -- Extern_init: EC_0 ARCH_0 |- "packet_out" "packet_out" : ARCH_1
  -- if EC_1 = $add_var_e(GLOBAL, EC_0, _BARE "packet_out", REF "packet_out")
  -- if externObject_packet_out = $find_object_e(ARCH_1, [ "packet_out" ])
  -- if EXTERN typeId `< theta `> `{ _ frame externMethodDefEnv `}
      = externObject_packet_out
  -- if externObject_packet_out_init
      = EXTERN typeId `< theta `> `{ objectState_packet_out frame externMethodDefEnv `}
  -- if ARCH_2
      = $add_object_e(ARCH_1, [ "packet_out" ], externObject_packet_out_init)

relation P4blo_init_globals:
  evalContext arch |- evalContext
  hint(input %0 %1)

rule P4blo_init_globals:
  EC_0 ARCH |- EC_2
  -- if PACKAGE `< theta `> `{ _ `}
      = $find_object_e(ARCH, [ "main" ])
  -- if typeIR_hdr = $find_map<typeId, typeIR>(theta, "H")
  -- if typeIR_meta = $find_map<typeId, typeIR>(theta, "M")
  -- Var_init: EC_0 |- typeIR_hdr "hdr" : EC_1
  -- Var_init: EC_1 |- typeIR_meta "meta" : EC_2

;;
;; Arguments and callees
;;

dec $P4blo_packet_in_argument(evalContext) : argumentIR
def $P4blo_packet_in_argument(EC) = argumentIR_packet_in
  -- if typeDefIR_packet_in
      = $find_typeDef_e(GLOBAL, EC, _BARE "packet_in")
  -- if typeIR_packet_in
      = $specialize_typeDefIR(typeDefIR_packet_in, eps)
  -- if argumentIR_packet_in
      = ('.' "packet_in") '#' `( typeIR_packet_in CTK `)

dec $P4blo_packet_out_argument(evalContext) : argumentIR
def $P4blo_packet_out_argument(EC) = argumentIR_packet_out
  -- if typeDefIR_packet_out
      = $find_typeDef_e(GLOBAL, EC, _BARE "packet_out")
  -- if typeIR_packet_out
      = $specialize_typeDefIR(typeDefIR_packet_out, eps)
  -- if argumentIR_packet_out
      = ('.' "packet_out") '#' `( typeIR_packet_out CTK `)

dec $P4blo_hdr_argument(arch) : argumentIR
def $P4blo_hdr_argument(ARCH) = argumentIR_hdr
  -- if PACKAGE `< theta `> `{ _ `}
      = $find_object_e(ARCH, [ "main" ])
  -- if typeIR_hdr = $find_map<typeId, typeIR>(theta, "H")
  -- if argumentIR_hdr
      = ('.' "hdr") '#' `( typeIR_hdr DYN `)

dec $P4blo_meta_argument(arch) : argumentIR
def $P4blo_meta_argument(ARCH) = argumentIR_meta
  -- if PACKAGE `< theta `> `{ _ `}
      = $find_object_e(ARCH, [ "main" ])
  -- if typeIR_meta = $find_map<typeId, typeIR>(theta, "M")
  -- if argumentIR_meta
      = ('.' "meta") '#' `( typeIR_meta DYN `)

dec $P4blo_main_callee(evalContext, arch) : typedExpressionIR
def $P4blo_main_callee(EC, ARCH) = typedExpressionIR_main
  -- if typeDefIR_package
      = $find_typeDef_e(GLOBAL, EC, _BARE "P4blo")
  -- if PACKAGE `< theta `> `{ _ `}
      = $find_object_e(ARCH, [ "main" ])
  -- if typeIR_hdr = $find_map<typeId, typeIR>(theta, "H")
  -- if typeIR_meta = $find_map<typeId, typeIR>(theta, "M")
  -- if typeIR_package
      = $specialize_typeDefIR(typeDefIR_package, [ typeIR_hdr, typeIR_meta ])
  -- if typedExpressionIR_main
      = (_BARE "main") '#' `( typeIR_package CTK `)

;; The callee `main.<member>`, of the block type named `nameIR_type`
;; specialized to the package's H, and M too when `b_meta`.
dec $P4blo_block_callee(evalContext, arch, nameIR, nameIR, bool) : typedExpressionIR
def $P4blo_block_callee(EC, ARCH, nameIR_type, nameIR_member, b_meta)
  = typedExpressionIR_block
  -- if typeDefIR_block = $find_typeDef_e(GLOBAL, EC, _BARE nameIR_type)
  -- if PACKAGE `< theta `> `{ _ `}
      = $find_object_e(ARCH, [ "main" ])
  -- if typeIR_hdr = $find_map<typeId, typeIR>(theta, "H")
  -- if typeIR_meta = $find_map<typeId, typeIR>(theta, "M")
  -- if typeIR_block
      = $specialize_typeDefIR(typeDefIR_block,
          $ite<typeIR*>(b_meta, [ typeIR_hdr, typeIR_meta ], [ typeIR_hdr ]))
  -- if typedExpressionIR_main = $P4blo_main_callee(EC, ARCH)
  -- if typedExpressionIR_block
      = (typedExpressionIR_main '.' nameIR_member) '#' `( typeIR_block CTK `)

;;
;; Parser invocation
;;

relation P4blo_parser:
  evalContext arch |- evalContext arch transitionResult
  hint(input %0 %1)

rulegroup P4blo_parser {

  rule P4blo_parser/accept:
    EC_0 ARCH_0 |- EC_1 ARCH_1 ACCEPT
    -- if argumentIR*
        = [ $P4blo_packet_in_argument(EC_0),
            $P4blo_hdr_argument(ARCH_0),
            $P4blo_meta_argument(ARCH_0) ]
    -- if typedExpressionIR_p
        = $P4blo_block_callee(EC_0, ARCH_0, "P4bloParser", "p", true)
    -- if callableTargetIR = typedExpressionIR_p '.' "apply"
    -- Stmt_eval:
        GLOBAL EC_0 ARCH_0 |- callableTargetIR `< eps `> `( argumentIR* `) ';'
                            : EC_1 ARCH_1 _EMPTY

  rule P4blo_parser/reject:
    EC_0 ARCH_0 |- EC_1 ARCH_1 rejectTransitionResult
    -- if argumentIR*
        = [ $P4blo_packet_in_argument(EC_0),
            $P4blo_hdr_argument(ARCH_0),
            $P4blo_meta_argument(ARCH_0) ]
    -- if typedExpressionIR_p
        = $P4blo_block_callee(EC_0, ARCH_0, "P4bloParser", "p", true)
    -- if callableTargetIR = typedExpressionIR_p '.' "apply"
    -- Stmt_eval:
        GLOBAL EC_0 ARCH_0 |- callableTargetIR `< eps `> `( argumentIR* `) ';'
                            : EC_1 ARCH_1 rejectTransitionResult

}

;;
;; Control invocation
;;

relation P4blo_control:
  evalContext arch |- evalContext arch callResult
  hint(input %0 %1)

rulegroup P4blo_control {

  rule P4blo_control/return:
    EC_0 ARCH_0 |- EC_1 ARCH_1 (RETURN eps)
    -- if argumentIR*
        = [ $P4blo_hdr_argument(ARCH_0), $P4blo_meta_argument(ARCH_0) ]
    -- if typedExpressionIR_c
        = $P4blo_block_callee(EC_0, ARCH_0, "P4bloControl", "c", true)
    -- if callableTargetIR = typedExpressionIR_c '.' "apply"
    -- Stmt_eval:
        GLOBAL EC_0 ARCH_0 |- callableTargetIR `< eps `> `( argumentIR* `) ';'
                            : EC_1 ARCH_1 _EMPTY

  rule P4blo_control/exit:
    EC_0 ARCH_0 |- EC_1 ARCH_1 EXIT
    -- if argumentIR*
        = [ $P4blo_hdr_argument(ARCH_0), $P4blo_meta_argument(ARCH_0) ]
    -- if typedExpressionIR_c
        = $P4blo_block_callee(EC_0, ARCH_0, "P4bloControl", "c", true)
    -- if callableTargetIR = typedExpressionIR_c '.' "apply"
    -- Stmt_eval:
        GLOBAL EC_0 ARCH_0 |- callableTargetIR `< eps `> `( argumentIR* `) ';'
                            : EC_1 ARCH_1 EXIT

}

;;
;; Deparser invocation
;;

relation P4blo_deparser:
  evalContext arch |- evalContext arch callResult
  hint(input %0 %1)

rulegroup P4blo_deparser {

  rule P4blo_deparser/return:
    EC_0 ARCH_0 |- EC_1 ARCH_1 (RETURN eps)
    -- if argumentIR*
        = [ $P4blo_packet_out_argument(EC_0), $P4blo_hdr_argument(ARCH_0) ]
    -- if typedExpressionIR_d
        = $P4blo_block_callee(EC_0, ARCH_0, "P4bloDeparser", "d", false)
    -- if callableTargetIR = typedExpressionIR_d '.' "apply"
    -- Stmt_eval:
        GLOBAL EC_0 ARCH_0 |- callableTargetIR `< eps `> `( argumentIR* `) ';'
                            : EC_1 ARCH_1 _EMPTY

  rule P4blo_deparser/exit:
    EC_0 ARCH_0 |- EC_1 ARCH_1 EXIT
    -- if argumentIR*
        = [ $P4blo_packet_out_argument(EC_0), $P4blo_hdr_argument(ARCH_0) ]
    -- if typedExpressionIR_d
        = $P4blo_block_callee(EC_0, ARCH_0, "P4bloDeparser", "d", false)
    -- if callableTargetIR = typedExpressionIR_d '.' "apply"
    -- Stmt_eval:
        GLOBAL EC_0 ARCH_0 |- callableTargetIR `< eps `> `( argumentIR* `) ';'
                            : EC_1 ARCH_1 EXIT

}
