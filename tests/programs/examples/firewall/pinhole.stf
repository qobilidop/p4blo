# Exact output lengths; sequential packets share persistent state.
add services meta.server:0xc0000200/24 meta.server_port:443 allow()

# A reply cannot create a pinhole.
packet 2 000000000002000000000001080045000028007b400040066e53c00002010a00000101bb9c4000000000000000005012200000000000
no_packet

# Neither can a bare ACK from inside.
packet 1 000000000002000000000001080045000028007b400040066e530a000001c00002019c4001bb00000000000000005010200000000000
no_packet

# Inside SYN opens a slot.
packet 1 000000000002000000000001080045000028007b400040066e530a000001c00002019c4001bb00000000000000005002200000000000
expect 2 000000000002000000000001080045000028007b400040066e530a000001c00002019c4001bb00000000000000005002200000000000 $

# The return packet now passes unchanged.
packet 2 000000000002000000000001080045000028007b400040066e53c00002010a00000101bb9c4000000000000000005012200000000000
expect 1 000000000002000000000001080045000028007b400040066e53c00002010a00000101bb9c4000000000000000005012200000000000 $

# An unapproved service is denied.
packet 1 000000000002000000000001080045000028007b400040066e530a000001c00002019c40005000000000000000005002200000000000
no_packet

# Port 40003 collides with the resident tuple in slot 11.
packet 1 000000000002000000000001080045000028007b400040066e530a000001c00002019c4301bb00000000000000005002200000000000
no_packet

# The resident survives the collision.
packet 2 000000000002000000000001080045000028007b400040066e53c00002010a00000101bb9c4000000000000000005010200000000000
expect 1 000000000002000000000001080045000028007b400040066e53c00002010a00000101bb9c4000000000000000005010200000000000 $

# A FIN passes but does not close the slot.
packet 1 000000000002000000000001080045000028007b400040066e530a000001c00002019c4001bb00000000000000005011200000000000
expect 2 000000000002000000000001080045000028007b400040066e530a000001c00002019c4001bb00000000000000005011200000000000 $

# A subsequent reply still passes.
packet 2 000000000002000000000001080045000028007b400040066e53c00002010a00000101bb9c4000000000000000005010200000000000
expect 1 000000000002000000000001080045000028007b400040066e53c00002010a00000101bb9c4000000000000000005010200000000000 $
