# Four CRC buckets, flow affinity and explicit drop boundaries.
add services hdr.ipv4.dst:0x0a000064 hdr.udp.dst_port:8080 select_group(group:1)
add backends meta.group:1 meta.bucket:0 deliver(src_mac:0x100, dst_mac:0x101, port:1)
add backends meta.group:1 meta.bucket:1 deliver(src_mac:0x100, dst_mac:0x101, port:1)
add backends meta.group:1 meta.bucket:2 deliver(src_mac:0x200, dst_mac:0x202, port:2)
add backends meta.group:1 meta.bucket:3 deliver(src_mac:0x200, dst_mac:0x202, port:2)
# source port 10001 -> backend 1
packet 0 000000000002000000000001080045000020007b400040116dedc00002010a00006427111f90000c000070696e67
expect 1 000000000101000000000100080045000020007b40003f116eedc00002010a00006427111f90000c000070696e67 $
# source port 10000 -> backend 1
packet 0 000000000002000000000001080045000020007b400040116dedc00002010a00006427101f90000c000070696e67
expect 1 000000000101000000000100080045000020007b40003f116eedc00002010a00006427101f90000c000070696e67 $
# source port 10241 -> backend 2
packet 0 000000000002000000000001080045000020007b400040116dedc00002010a00006428011f90000c000070696e67
expect 2 000000000202000000000200080045000020007b40003f116eedc00002010a00006428011f90000c000070696e67 $
# source port 10240 -> backend 2
packet 0 000000000002000000000001080045000020007b400040116dedc00002010a00006428001f90000c000070696e67
expect 2 000000000202000000000200080045000020007b40003f116eedc00002010a00006428001f90000c000070696e67 $
# Changing the application payload preserves flow selection.
packet 0 000000000002000000000001080045000020007b400040116dedc00002010a00006427101f90000c0000706f6e67
expect 1 000000000101000000000100080045000020007b40003f116eedc00002010a00006427101f90000c0000706f6e67 $
